<Project Sdk="Microsoft.NET.Sdk">
    <!-- ImageCrystal modifications by xenon, 2026-10-18; see NOTICE.ImageCrystal.txt. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AppBuild>../../Source/ImageGlass/bin/x64/Release/net10.0-windows10.0.17763.0</AppBuild>
  </PropertyGroup>
  <!-- Test the compiled app binaries, including their native decoders. -->
  <ItemGroup>
    <Reference Include="Microsoft.Extensions.Configuration.Abstractions"><HintPath>$(AppBuild)/Microsoft.Extensions.Configuration.Abstractions.dll</HintPath></Reference>
    <Reference Include="ImageGlass.Base"><HintPath>$(AppBuild)/ImageGlass.Base.dll</HintPath></Reference>
    <Reference Include="ImageCrystal"><HintPath>$(AppBuild)/ImageCrystal.dll</HintPath></Reference>
    <Reference Include="ImageGlass.Settings"><HintPath>$(AppBuild)/ImageGlass.Settings.dll</HintPath></Reference>
    <Reference Include="ImageGlass.UI"><HintPath>$(AppBuild)/ImageGlass.UI.dll</HintPath></Reference>
    <Reference Include="ImageGlass.Viewer"><HintPath>$(AppBuild)/ImageGlass.Viewer.dll</HintPath></Reference>
    <Reference Include="ImageGlass.Gallery"><HintPath>$(AppBuild)/ImageGlass.Gallery.dll</HintPath></Reference>
    <Reference Include="Magick.NET.Core"><HintPath>$(AppBuild)/Magick.NET.Core.dll</HintPath></Reference>
    <Reference Include="Magick.NET.SystemWindowsMedia"><HintPath>$(AppBuild)/Magick.NET.SystemWindowsMedia.dll</HintPath></Reference>
    <Reference Include="Magick.NET-Q16-HDRI-OpenMP-x64"><HintPath>$(AppBuild)/Magick.NET-Q16-HDRI-OpenMP-x64.dll</HintPath></Reference>
    <Reference Include="WicNet"><HintPath>$(AppBuild)/WicNet.dll</HintPath></Reference>
    <Reference Include="DirectNStandard"><HintPath>$(AppBuild)/DirectNStandard.dll</HintPath></Reference>
  </ItemGroup>
</Project>
